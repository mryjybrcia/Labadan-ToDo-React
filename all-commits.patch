diff --git a/src/Hooks/useTicker.js b/src/Hooks/useTicker.js
new file mode 100644
index 0000000..f74d435
--- /dev/null
+++ b/src/Hooks/useTicker.js
@@ -0,0 +1,18 @@
+import { useEffect, useState } from "react";
+
+/**
+ * Re-renders once a second while `active`, so a running timer counts up.
+ * When inactive no interval is registered at all.
+ */
+export default function useTicker(active, intervalMs = 1000) {
+  const [now, setNow] = useState(() => Date.now());
+
+  useEffect(() => {
+    if (!active) return undefined;
+    setNow(Date.now());
+    const id = setInterval(() => setNow(Date.now()), intervalMs);
+    return () => clearInterval(id);
+  }, [active, intervalMs]);
+
+  return now;
+}
